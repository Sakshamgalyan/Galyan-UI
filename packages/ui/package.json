{
  "name": "@galyan/ui",
  "version": "1.0.11",
  "description": "React UI Components with Galyan Design System",
  "author": "Saksham Galyan",
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sakshamgalyan/Galyan-UI.git"
  },
  "homepage": "https://github.com/Sakshamgalyan/Galyan-UI",
  "bugs": {
    "url": "https://github.com/Sakshamgalyan/Galyan-UI/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.26.28",
    "@galyan/theme": "workspace:*",
    "d3-geo": "^3.1.1",
    "recharts": "^2.15.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/react": "^8.6.14",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.39.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
