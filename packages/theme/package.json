{
  "name": "@galyan/theme",
  "version": "0.0.2",
  "description": "Design tokens, themes, CSS variables, and global styles for Galyan UI.",
  "author": "Saksham Galyan",
  "license": "MIT",
  "private": false,
  "type": "module",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sakshamgalyan/Galyan-UI.git"
  },

  "homepage": "https://github.com/Sakshamgalyan/Galyan-UI",

  "bugs": {
    "url": "https://github.com/Sakshamgalyan/Galyan-UI/issues"
  },

  "keywords": [
    "theme",
    "design-system",
    "tokens",
    "css",
    "colors",
    "typography",
    "spacing",
    "react",
    "nextjs"
  ],

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },

    "./css/reset": "./dist/css/reset.css",
    "./css/globals": "./dist/css/globals.css",
    "./css/variables": "./dist/css/variables.css",
    "./css/fonts": "./dist/css/fonts.css"
  },

  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],

  "sideEffects": [
    "**/*.css"
  ],

  "publishConfig": {
    "access": "public"
  },

  "engines": {
    "node": ">=20"
  },

  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },

  "dependencies": {},

  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "typescript": "^5.9.2",
    "tsup": "^8.5.1",
    "eslint": "^9.39.1"
  }
}